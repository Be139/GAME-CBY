  lines:
  - startDelay: 0.15
    speaker: Mia
    text: I'll be there.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Promise?
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: I promise.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: "What if work\u2014"
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: No what-ifs, sweetheart. I promise.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Then can you listen? I want to do it for you this time.
    holdSeconds: 6.0556602
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: Yeah. Go ahead.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: That was really good.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: I did it by myself?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: Every word.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: What happens to it?
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
