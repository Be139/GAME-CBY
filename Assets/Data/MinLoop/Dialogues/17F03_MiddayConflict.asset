  notes: Midday conflict begins before mediation.
  lines:
  - startDelay: 0.4
    speaker: Mother
    text: All you ever do is stare at that phone!
    holdSeconds: 2.6
    voiceClip: {fileID: 0}
  - startDelay: 0.25
