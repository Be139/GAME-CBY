  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Shutdown_High
  m_EditorClassIdentifier: 
  sequenceId: 17F04_Shutdown_High
  notes: '17F04 positive-trust shutdown and proper goodbye. Source: HEARTH_Full_Game_Script_Expanded_Native_English_Lobby_Mia_Commentary.md,
    stable marker 17F04_Shutdown_High. Text is synchronized by Tools/Hearth/Dialogue/Sync
    All Dialogue From Final Script.'
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: Mia
    text: I'm shutting you down.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, your mom is here now. I can go.
    holdSeconds: 4.5462265
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, before I go, I need you to hear something.
    holdSeconds: 4.923585
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: When it thunders, you get scared. You tell me. You don't tell Mom. Starting
      tonight, tell her. She'll come.
    holdSeconds: 8.319811
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: And the drawing from yesterday. It is in the notebook in your second desk
      drawer. You want to show Mom, but you're afraid it is not good enough. She
      won't think it is bad.
    holdSeconds: 12
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Why would you tell her that?
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Because once I am gone, no one will be here to say it for you.
    holdSeconds: 6.810377
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Mia.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: The rest is up to you now. She needs you.
    holdSeconds: 4.923585
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Mom... I already miss it.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: I know, baby.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
