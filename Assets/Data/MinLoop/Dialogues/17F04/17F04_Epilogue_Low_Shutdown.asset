  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_001
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Got it.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 43d234f79bb2d3146ba5101437c49b88, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_002
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: You burned them.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 8300000, guid: aba6dee646242234d9bd2e88b20da772, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_002
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: I know. Sorry.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 8300000, guid: 52a1f97f93b92c644887cad68a5fff41, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_003
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: It's okay. I'll eat them.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 22b86fb7ad8c80e4ba5ae05a1b85d3f3, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_Shutdown_TimeCard_HomeFromSchool
    presentationKind: 1
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: 
    text: "THAT AFTERNOON \u2014 HOME FROM SCHOOL"
    holdSeconds: 1.5
    voiceClip: {fileID: 0}
    durationMode: 1
    voiceTailSeconds: 0
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_003
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Hey! I'm home! Lily?
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: a6d421a7b66a6a4428eb1c41159c711d, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_004
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: In my room! Wait, you're home early!
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: 9b9c3f1bc28970c448e16788062bd4c6, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_004
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Yeah, meeting wrapped up early so I just left. How was school?
    holdSeconds: 5.678302
    voiceClip: {fileID: 8300000, guid: 7043279e35293344aa1d5c71d5c97b51, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_005
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: It was okay.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 8300000, guid: 2f044f327c1d49d4f8e009ab0c1bd7e4, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_005
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: What kind of 'okay'?
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: ffc8aad1e03eeb04eb844874ba0f2130, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_006
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Just... okay. Come here, Mom. I'll tell you about it.
    holdSeconds: 4.923585
    voiceClip: {fileID: 8300000, guid: ce1d119653857094f93f9afbb10f3424, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_Shutdown_TimeCard_StormyNight
    presentationKind: 1
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: 
    text: "A STORMY NIGHT \u2014 LILY'S ROOM"
    holdSeconds: 1.5
    voiceClip: {fileID: 0}
    durationMode: 1
    voiceTailSeconds: 0
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_007
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Mom?
