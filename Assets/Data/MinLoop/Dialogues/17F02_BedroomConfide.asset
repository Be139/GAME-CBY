  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F02_BedroomConfide
  m_EditorClassIdentifier: 
  sequenceId: 17F02_BedroomConfide
  notes: Bedroom confide sequence. The robot can move in a limited room area while
    this plays.
  lines:
  - startDelay: 0.4
    speaker: Wife
    text: I do not know why I keep telling you first.
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Wife
    text: It is easier than saying it at the table.
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.4
    speaker: Companion Unit
    text: I am listening.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Wife
    text: Today was exhausting. I just need a minute before I go out there.
    holdSeconds: 4
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
