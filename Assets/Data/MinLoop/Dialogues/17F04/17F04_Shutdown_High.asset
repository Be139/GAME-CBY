    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 7ca8884809724be4e8df381d09d7bb3d, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Shutdown_High_17F04_Shutdown_Low_MiasHomeUnit_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, your mom's here now. I can go.
    holdSeconds: 4.1688676
    voiceClip: {fileID: 8300000, guid: 11416540ec9c89443b0fd307e01ca6f8, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Shutdown_High_MiasHomeUnit_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, before I go, I need you to hear something.
    holdSeconds: 4.923585
    voiceClip: {fileID: 8300000, guid: 3fe75e28c8b12d748b68b8affb6d4226, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Shutdown_High_MiasHomeUnit_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: "When it thunders, you get scared. You always tell me, but you never tell
      Mom. Starting tonight\u2014tell her. She'll come."
    holdSeconds: 8.697169
    voiceClip: {fileID: 8300000, guid: 3e1e30185e67c884fbedfaa66792a782, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Shutdown_High_MiasHomeUnit_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Mia.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: b0e25cb6b27d917438a740a7533adc07, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Shutdown_High_MiasHomeUnit_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: The rest is yours now. She needs you.
    holdSeconds: 4.1688676
    voiceClip: {fileID: 8300000, guid: d3f11ba5004e703468876d9ce3e96f34, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
