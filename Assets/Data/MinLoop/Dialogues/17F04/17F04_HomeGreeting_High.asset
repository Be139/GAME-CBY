  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_HomeGreeting_High
  m_EditorClassIdentifier: 
  sequenceId: 17F04_HomeGreeting_High
  notes: High-trust greeting after entering Mia's home.
  lines:
  - startDelay: 0.2
    speaker: Field Companion
    text: Inspector, all three households have been processed tonight.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Field Companion
    text: Honestly, you have been one of the most cooperative inspectors I have worked
      with.
    holdSeconds: 4.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Field Companion
    text: Now that you are home, would you like to experience again the convenience
      a Companion Unit brings to you and Lily every day?
    holdSeconds: 5.4
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
