  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_DaughterRoom_High
  m_EditorClassIdentifier: 
  sequenceId: 17F04_DaughterRoom_High
  notes: Daughter-room dialogue before the final choice, high-trust variation.
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: Mia's Home Unit
    text: You're home.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Mom?
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: Hey. It's me.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Did you come in on your own this time?
    holdSeconds: 4.5462265
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: I did.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: We have one more run-through. Let's finish that, then we can talk about
      anything else. Okay?
    holdSeconds: 7.1877356
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Mom, I'm not asking about my speech.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Inspector, Lily's sleep will be more stable if I complete tonight's session.
      I recommend that we finish.
    holdSeconds: 7.565094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: I heard you.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Mom. Are you coming tomorrow?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
