  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F02_BedroomComfort
  m_EditorClassIdentifier: 
  sequenceId: 17F02_BedroomComfort
  notes: Companion response after the player confirms the bedroom comfort interaction.
  lines:
  - startDelay: 0.1
    speaker: Companion Unit
    text: I am here. You are not alone in this room.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Companion Unit
    text: Your breathing is steadying. We can take the next moment slowly.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
  - startDelay: 0.4
    speaker: Wife
    text: ...Thank you.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
