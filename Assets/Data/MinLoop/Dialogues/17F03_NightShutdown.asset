--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F03_NightShutdown
  m_EditorClassIdentifier: 
  sequenceId: 17F03_NightShutdown
  notes: Maintenance menu and core service shutdown.
  lines:
  - startDelay: 0.2
    speaker: Companion Unit
    text: I can tell that you are emotional today. Perhaps we can begin with-
    holdSeconds: 3.7
    voiceClip: {fileID: 0}
  - startDelay: 0.1
    speaker: Daughter
    text: Enough.
    holdSeconds: 1.6
    voiceClip: {fileID: 0}
  - startDelay: 0.5
    speaker: System
    text: 'Display opened. Operator: daughter. Permission: basic user.'
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: System
    text: Maintenance menu accessed. Core services selected.
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: System
    text: Core services shutting down. This unit will enter deep sleep.
    holdSeconds: 3.5
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Synth Voice
    text: Deep sleep initiated. Normal restart path locked.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
