%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Epilogue_High_Shutdown
  m_EditorClassIdentifier: 
  sequenceId: 17F04_Epilogue_High_Shutdown
  notes: 'Centered black-screen ending: high trust plus shutdown.'
  lines:
  - startDelay: 0.3
    speaker: Field Companion
    text: Inspector... the household unit has been shut down.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Field Companion
    text: This does not match your usual decisions tonight. The data marks it as
      an anomaly.
    holdSeconds: 4.4
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Field Companion
    text: But I do not know why... I feel this should not be recorded as an anomaly.
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Field Companion
    text: This shift is over. Thank you for your work.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
  - startDelay: 0.8
    speaker: Lily
    text: Mom, the eggs do not need to be cooked that long.
    holdSeconds: 3.3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: Sorry.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Lily
    text: It is okay. I will eat them.
    holdSeconds: 2.6
    voiceClip: {fileID: 0}
  - startDelay: 0.8
    speaker: Lily
    text: Mom.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: I am here.
    holdSeconds: 2
    voiceClip: {fileID: 0}
  - startDelay: 0.4
    speaker: Lily
    text: I never told you I was afraid of thunder.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: Mom knows now.
    holdSeconds: 2.4
    voiceClip: {fileID: 0}
  - startDelay: 0.6
    speaker: Lily
    text: You look tired. You can go to sleep.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: I will stay a little longer.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.8
    speaker: System
    text: Lily, age 9. Open Day, the next morning. Mom came and sat in the first
      row. She took the day off and turned off her phone all afternoon.
    holdSeconds: 6.5
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
