--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F03_NightDaughter
  m_EditorClassIdentifier: 
  sequenceId: 17F03_NightDaughter
  notes: The daughter approaches the unit at night.
  lines:
  - startDelay: 0.3
    speaker: Daughter
    text: Can you stop speaking for us?
    holdSeconds: 2.7
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Companion Unit
    text: If you want to speak directly to your parents, I can step aside.
    holdSeconds: 4
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Daughter
    text: That is not what I mean.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Daughter
    text: My mother used to get angry with me. My father used to knock on my door
      himself. Now neither of them does.
    holdSeconds: 5.3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Daughter
    text: Today Dad came home and asked you how I was. He asked you, not me.
    holdSeconds: 4.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Daughter
    text: At dinner the three of us sat at one table and nobody spoke. The food was
      warm. The people were cold.
    holdSeconds: 5.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Daughter
    text: You understand them more and more. They understand me less and less.
    holdSeconds: 4.4
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
