    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia
    text: Hey, baby. It's me.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: a50a637163536b74da6d5fa2063ce0a8, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_DaughterRoom_High_17F04_DaughterRoom_Low_Lily_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Lily
    text: Did you come in by yourself this time?
    holdSeconds: 4.1688676
    voiceClip: {fileID: 8300000, guid: 65d7ab0a2047b2d4385184ec90ad25f6, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_DaughterRoom_High_17F04_DaughterRoom_Low_Mia_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia
    text: I did.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 0ffa76c78884d8e408f4407994e4270a, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_DaughterRoom_High_17F04_DaughterRoom_Low_MiasHomeUnit_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: We have one more run-through. Let's finish that, then we can talk about
      anything else. Okay?
    holdSeconds: 7.1877356
    voiceClip: {fileID: 8300000, guid: cad1dae44fea31041a48db8c9741c7fb, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
