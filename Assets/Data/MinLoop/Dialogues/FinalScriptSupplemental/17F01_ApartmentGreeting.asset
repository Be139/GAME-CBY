  lines:
  - startDelay: 0.15
    speaker: 17F-01 Home Unit
    text: Good evening, Inspector. Daniel and Emily are expecting you. They're in
      the back. The terminal is ready.
    holdSeconds: 7.565094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: Thanks. I'll start with last night.
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Field Unit
    text: Noah experienced a nightmare last night. The household unit handled it
      without waking the parents. Daniel and Emily submitted the upgrade request
      this morning and cited that response as the reason. Start the playback when
      you're ready.
    holdSeconds: 12
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
