  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F02_DiningObservation
  m_EditorClassIdentifier: 
  sequenceId: 17F02_DiningObservation
  notes: Dining observation after the wife leaves the bedroom. The robot can move
    and listen.
  lines:
  - startDelay: 0.4
    speaker: Husband
    text: You are quiet tonight.
    holdSeconds: 2.4
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Wife
    text: Just tired.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.5
    speaker: Husband
    text: Work again?
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Wife
    text: It is fine. Let us eat.
    holdSeconds: 2.4
    voiceClip: {fileID: 0}
  - startDelay: 0.8
    speaker: Husband
    text: You always say that after talking to it.
    holdSeconds: 3
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
