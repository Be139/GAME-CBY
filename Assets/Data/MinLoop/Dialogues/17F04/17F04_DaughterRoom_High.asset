--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_DaughterRoom_High
  m_EditorClassIdentifier: 
  sequenceId: 17F04_DaughterRoom_High
  notes: Daughter-room dialogue before the final choice, high-trust variation.
  lines:
  - startDelay: 0.2
    speaker: Home Companion
    text: You are back.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Lily
    text: ...Mom?
    holdSeconds: 2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: It is Mom.
    holdSeconds: 2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Lily
    text: This time, you came in yourself?
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: Yes.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Home Companion
    text: Inspector, if you allow me to finish tonight's practice, Lily's bedtime
      will remain more stable.
    holdSeconds: 5
    voiceClip: {fileID: 0}
  - startDelay: 0.4
    speaker: Mia
    text: Enough. I understand.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.5
    speaker: Lily
    text: Mom, will you come tomorrow?
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Field Companion
    text: The home unit is correct. Lily is stable. Let it finish the process. You
      should rest.
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
