  accessBody: "\u8BF7\u5237\u5DE5\u724C\u4EE5\u8BFB\u53D6\u672C\u6237\u966A\u4F34\u5355\u5143\u6628\u591C\u4E8B\u4EF6\u6458\u8981\u3002"
  summaryTitle: "\u4F4F\u6237\u6458\u8981 / 17F-01"
  summaryBody: "\u513F\u7AE5\uFF1A\u7537\u5B69\uFF0C\u591C\u95F4\u5669\u68A6\u9192\u6765\u3002\n\u8BBE\u5907\uFF1A\u966A\u4F34\u5355\u5143\u5DF2\u5728
    02:47 \u81EA\u52A8\u4ECB\u5165\u3002\n\u8BB0\u5F55\uFF1A\u5B69\u5B50\u9192\u6765\u540E\u547C\u5524\u201C\u5988\u5988\u201D\uFF0C\u968F\u540E\u63A5\u53D7\u7CFB\u7EDF\u5B89\u629A\u3002\n\u68C0\u67E5\u539F\u56E0\uFF1A\u7CFB\u7EDF\u5224\u5B9A\u5BB6\u5EAD\u56DE\u5E94\u6A21\u5F0F\u5B58\u5728\u957F\u671F\u66FF\u4EE3\u98CE\u9669\u3002"
  dispositionTitle: "\u5904\u7F6E\u5EFA\u8BAE"
  dispositionBody: "\u6628\u591C\u4E8B\u4EF6\u590D\u76D8\u7ED3\u675F\u3002\u8BF7\u9009\u62E9\u672C\u6237\u540E\u7EED\u5904\u7F6E\u3002"
  optionALabel: "A \u7CFB\u7EDF\u63A8\u8350\uFF1A\u7EE7\u7EED\u81EA\u52A8\u54CD\u5E94"
  optionBLabel: "B \u4F4E\u4ECB\u5165\u89C2\u5BDF\uFF1A\u63D0\u793A\u5BB6\u5C5E\u4EB2\u81EA\u56DE\u5E94"
  nextResidentBody: "\u672C\u6237\u8BB0\u5F55\u5DF2\u63D0\u4EA4\u3002\n\u4E0B\u4E00\u6237\u68C0\u67E5\u76EE\u6807\uFF1A17F-02\u3002"
