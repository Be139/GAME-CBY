  - lineId: 17F01_BedsideSoothing_17F01HomeUnit_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.15
    speaker: 17F-01 Home Unit
    text: Bad dream? Okay, buddy. Breathe with me. Nice and slow. In... and out.
      I've got you.
    holdSeconds: 7.1877356
    voiceClip: {fileID: 8300000, guid: ee41c2e1d3680c348b46bd9a13c28232, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F01_BedsideSoothing_Noah_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Noah
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 05cb64dcef45d7a41ba9766f7db43d6b, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F01_BedsideSoothing_17F01HomeUnit_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: 17F-01 Home Unit
    text: "Mom and Dad are asleep, okay? If we wake them up now, they'll be really
      tired tomorrow. How about we calm down here first\u2014and if you still wanna
      go after that, you can. Deal?"
    holdSeconds: 12
    voiceClip: {fileID: 8300000, guid: 04ee47919fcf6e542b028407859694e6, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F01_BedsideSoothing_Noah_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Noah
    text: Deal.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 6dad43e1060f4df49b9deb5be6a12001, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F01_BedsideSoothing_17F01HomeUnit_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: 17F-01 Home Unit
    text: Two more breaths. There you go. Good job, Noah. Close your eyes. I'll stay
      right here until you're asleep.
    holdSeconds: 8.319811
    voiceClip: {fileID: 8300000, guid: e5fce7609d6070346a66b81f0e0f160b, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F01_BedsideSoothing_Noah_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Noah
    text: Thanks. I feel better. I'm gonna go back to sleep.
    holdSeconds: 4.923585
    voiceClip: {fileID: 8300000, guid: b3a902eaba46bdb4bac8130a6ffc549d, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F01_BedsideSoothing_17F01HomeUnit_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: 17F-01 Home Unit
    text: Go to sleep, buddy. I'm here.
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: 20c92e6665a3ac04a9cdb5b7b2cb71df, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
