  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_AnswerSelf
  m_EditorClassIdentifier: 
  sequenceId: 17F04_AnswerSelf
  notes: 'A route: Mia answers Lily herself; free movement remains enabled.'
  lines:
  - startDelay: 0.3
    speaker: Mia
    text: I will be there.
    holdSeconds: 2.5
    voiceClip: {fileID: 0}
  - startDelay: 0.35
    speaker: Lily
    text: ...Do you promise?
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Mia
    text: Mom promises.
    holdSeconds: 2.5
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Lily
    text: What if...
    holdSeconds: 2
    voiceClip: {fileID: 0}
  - startDelay: 0.15
    speaker: Mia
    text: There is no what if. Mom promises.
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.5
    speaker: Lily
    text: Then listen to me. This time, I want to say it to you.
    holdSeconds: 3.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: Okay.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.7
    speaker: Lily
    text: ...Was that really mine?
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mia
    text: It was yours.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
  - startDelay: 0.5
    speaker: Lily
    text: Then what about it?
    holdSeconds: 2.6
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
