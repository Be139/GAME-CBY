    startDelay: 0.15
    speaker: Ben
    text: You okay? How was work?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: e9eb368e05fd65a49bffe161dca27e5d, type: 3}
    durationMode: 0
