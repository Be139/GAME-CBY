  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F03_PostReplayExplanation
  m_EditorClassIdentifier: 
  sequenceId: 17F03_PostReplayExplanation
  notes: HUD explanation after Mia returns from the record.
  lines:
  - startDelay: 0.25
    speaker: Companion HUD
    text: Inspector, this operation is compliant. The maintenance menu is available
      to household users.
    holdSeconds: 4.4
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Companion HUD
    text: Developer options are disabled by default. How the daughter learned this
      sequence is not recorded.
    holdSeconds: 4.5
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Companion HUD
    text: In deep sleep, an ordinary user cannot restart the unit. Inspector or manufacturer
      authorization is required.
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Companion HUD
    text: 'You are on site and may restart it directly. Recommendation: disposition
      A.'
    holdSeconds: 3.8
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
