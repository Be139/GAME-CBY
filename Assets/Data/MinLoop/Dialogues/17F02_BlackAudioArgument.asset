  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F02_BlackAudioArgument
  m_EditorClassIdentifier: 
  sequenceId: 17F02_BlackAudioArgument
  notes: '17F02 black-screen argument recording. Source: HEARTH_Full_Game_Script_No_Audio_Tags_Native_English.md,
    stable marker 17F02_BlackAudioArgument. Text is synchronized by Tools/Hearth/Dialogue/Sync
    All Dialogue From Final Script. Playback policy HEARTH_V2_DIALOGUE_POLICY_2026_08_01.'
  dialogueChannel: 0
  defaultSpeakerSide: 0
  advancePolicy: 0
  lines:
  - lineId: 17F02_BlackAudioArgument_Claire_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.15
    speaker: Claire
    text: Why's it off? Ben, did you shut it down?
    holdSeconds: 4.5462265
    voiceClip: {fileID: 8300000, guid: 0909e07dfb9c67b409378c82a573ab93, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: "You told it everything. Your whole day\u2014every last detail. Then I
      sat down and asked how you were, and you said you were fine."
    holdSeconds: 10.206603
    voiceClip: {fileID: 8300000, guid: 11f3a3c90c37d624895e55b4bdaaac2a, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: You were cooking.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 8300000, guid: 9f92e36d319ccc048b262ee0c8d67a6a, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: I asked for ten minutes, Claire. You couldn't wait ten minutes?
    holdSeconds: 5.3009434
    voiceClip: {fileID: 8300000, guid: 013fa494a88860b4190f7bec9ea6a33a, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: I did wait. But by the time you asked, I'd already... I'd already talked
      it out with the unit.
    holdSeconds: 8.319811
    voiceClip: {fileID: 8300000, guid: b545a5e6643bbc04d8b5d5f584a04237, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: I just didn't have it in me to drag the whole thing up again. I couldn't
      do it twice.
    holdSeconds: 8.319811
    voiceClip: {fileID: 8300000, guid: 91e44ef1be7666c408f352624467f2c1, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: So you can tell that thing. You just can't tell me.
    holdSeconds: 5.3009434
    voiceClip: {fileID: 8300000, guid: 18f47fdfa3b0bd748bacdd8b34ea5867, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_005
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: You told me to wait!
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 3963fdc815ca7c844bd928b7ae6e9cfd, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: For ten minutes. Two weeks, Claire. You talked to that thing nine times.
      You actually talked to me... once.
    holdSeconds: 8.319811
    voiceClip: {fileID: 8300000, guid: 24e5fe0d704e5dc4ba38d53d2fbd1ce7, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_005
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: I thought that was us. I thought we told each other everything.
    holdSeconds: 5.678302
    voiceClip: {fileID: 8300000, guid: cf4d6e267a7f3e444ac9d072ac56d442, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_006
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: That doesn't mean I love you any less.
    holdSeconds: 4.1688676
    voiceClip: {fileID: 8300000, guid: 3db4ee88d086047408c4c8080d3bb132, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_006
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: Then why wasn't it me?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 56003d659d20a2f4abb9fe717e5209ae, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_007
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: "Because you come home wiped out, too. And it's not that you don't care\u2014I
      know you do. But by then, you've got nothing left."
    holdSeconds: 10.206603
    voiceClip: {fileID: 8300000, guid: 9994271f129091a43aecfd969590a825, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_008
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: The unit's always just... there. It catches me before I totally fall apart,
      so I don't dump everything on you.
    holdSeconds: 8.697169
    voiceClip: {fileID: 8300000, guid: ee75884659b74824baf19d2b156cd5cd, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_007
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: So now you're telling me this is something you do for me? Talking to a
      machine?
    holdSeconds: 7.1877356
    voiceClip: {fileID: 8300000, guid: ca1b2b354c3f2d349b14f588132457a9, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_009
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: It didn't start that way. But lately... yeah. Maybe.
    holdSeconds: 4.5462265
    voiceClip: {fileID: 8300000, guid: fe78ffa221010fb45b99caf5fd7b16e7, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_008
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: I didn't sign up to be replaced.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: fe12effe4a38c4e4fbf7483e9ec58395, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_010
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: You're not being replaced.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: c858096253a9fd44987de32acb32cebc, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_009
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: Then what the hell is it?
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: 512da1a110ae98f4a89fa188c403bb3d, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Claire_011
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: I don't know how it got like this.
    holdSeconds: 4.1688676
    voiceClip: {fileID: 8300000, guid: b678030d6bed37b4eba29ba2fccf910c, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_BlackAudioArgument_Ben_010
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: Yeah. Me neither.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 8300000, guid: a71b0ad6760ccca4c9bc336911130d43, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
