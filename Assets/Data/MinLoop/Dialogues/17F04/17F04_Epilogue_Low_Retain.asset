%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Epilogue_Low_Retain
  m_EditorClassIdentifier: 
  sequenceId: 17F04_Epilogue_Low_Retain
  notes: 'Centered black-screen ending: low trust plus retaining the unit.'
  lines:
  - startDelay: 0.3
    speaker: Field Companion
    text: Inspector...
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Field Companion
    text: In every other home tonight, you never let a unit speak in place of a resident.
    holdSeconds: 4.5
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.5
    speaker: Field Companion
    text: In your own home... you let it speak for you.
    holdSeconds: 3.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Field Companion
    text: I will not ask why. This shift is over. Thank you for your work.
    holdSeconds: 4.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Lily
    text: Last night, Mom wanted to speak to me herself, did she not?
    holdSeconds: 3.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Home Companion
    text: I am not certain what you mean.
    holdSeconds: 3
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Lily
    text: You are certain. You remember everything.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Lily
    text: Mom had already crouched down. She wanted to speak to me herself.
    holdSeconds: 4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Home Companion
    text: ...I have no record of that intention.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Lily
    text: You do. You have everything.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Lily
    text: That night, you meant to answer me yourself.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Mia
    text: Yes.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.4
    speaker: Lily
    text: I know. I always knew.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: System
    text: 'Family Emotional Stability: SAFE. Note: resident repeatedly demonstrated
      high autonomous-disposition tendencies. Next review: three years.'
    holdSeconds: 6.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  postSequenceDelay: 0
