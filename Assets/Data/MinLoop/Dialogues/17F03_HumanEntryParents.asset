--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F03_HumanEntryParents
  m_EditorClassIdentifier: 
  sequenceId: 17F03_HumanEntryParents
  notes: Parents explain the offline unit after Mia enters.
  lines:
  - startDelay: 0.25
    speaker: Mother
    text: You got here fast. Is this thing broken? Can you fix it?
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Mia
    text: Let me see what happened.
    holdSeconds: 2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mother
    text: Please get it running again. This machine really is good.
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mother
    text: Before we bought it, my daughter and I argued every few days. This house
      has been much quieter for the last year.
    holdSeconds: 5
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mother
    text: We are both busy. She talks to the unit, and it reports her condition to
      us. We know what is happening without missing work.
    holdSeconds: 5.2
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Father
    text: We tried the power switch several times. The display stayed black.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.25
    speaker: Mia
    text: ...All right. I will check today's record.
    holdSeconds: 2.6
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Mother
    text: Please hurry. She has school tomorrow.
    holdSeconds: 2.5
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
