  - lineId: 17F02_DiningObservation_Claire_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: Fine. Just a long day.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 3c3c6d9d7c3c961428e870ebe35ad807, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_DiningObservation_Ben_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: That manager of yours leave you alone today? He was riding you pretty hard
      last week.
    holdSeconds: 7.1877356
    voiceClip: {fileID: 8300000, guid: f81e7a75f079bbf4cb6a7fc2ed9e3ed2, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_DiningObservation_Claire_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: He brought it up again. It's whatever.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: 903ce948e0b0ffc4c84f919f25d9a024, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_DiningObservation_Ben_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: You sure, babe? You look wiped.
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: 32fcb77f8430d944d9dac69ed9534bf4, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_DiningObservation_Claire_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Claire
    text: Yeah. I'm just tired. Let's eat.
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: ff60b64ccc627334e8357b14740ec710, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_DiningObservation_Ben_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 63c4b9f051efea14a8356381eda09de3, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F02_DiningObservation_Ben_005
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Ben
    text: You've been saying that a lot lately.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: 05f1ea64061d771418f6a933f912bb3f, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
