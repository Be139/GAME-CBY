  sequenceId: 17F02_DiningObservation
  notes: '17F02 dining-room observation. Source: HEARTH_Full_Game_Script_Expanded_Native_English_Lobby_Mia_Commentary.md,
    Scene 2.3. Text is synchronized by Tools/Hearth/Dialogue/Sync All Dialogue From
    Final Script.'
  lines:
  - startDelay: 0.15
    speaker: Ben
    text: You okay? How was work?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Claire
    text: Fine. Just a long day.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Ben
    text: Your manager leave you alone today? He was on your case last week.
    holdSeconds: 6.0556602
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Claire
    text: He brought it up again. It's fine.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Ben
    text: You sure, babe? You look wiped.
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Claire
    text: Yeah. I'm just tired. Let's eat.
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Ben
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Ben
    text: You've been saying that a lot lately.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Claire
    text: Work's just crazy right now.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
