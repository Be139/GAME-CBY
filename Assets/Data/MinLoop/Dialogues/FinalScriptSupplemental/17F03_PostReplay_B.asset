  sequenceId: 17F03_PostReplay_B
  notes: '17F03 option B result excluding the conditional warning. Source: HEARTH_Full_Game_Script_No_Audio_Tags_Native_English.md,
    stable marker 17F03_PostReplay_B. Text is synchronized by Tools/Hearth/Dialogue/Sync
