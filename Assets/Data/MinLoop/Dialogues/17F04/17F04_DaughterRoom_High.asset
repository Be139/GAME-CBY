    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Lily
    text: Mom, I'm not asking about the speech.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: 99c7f970b7b8535469043c27bd93acda, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_DaughterRoom_High_17F04_DaughterRoom_Low_MiasHomeUnit_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Inspector, Lily sleeps better when we finish the full session. I'd recommend
      we wrap up.
    holdSeconds: 6.810377
    voiceClip: {fileID: 8300000, guid: 56c540f9eeee6024fb2661a91082da1f, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
