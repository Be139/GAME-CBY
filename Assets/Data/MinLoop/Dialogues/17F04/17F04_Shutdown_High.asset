    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: eb52586dafebef94dba8380c412b7e06, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
