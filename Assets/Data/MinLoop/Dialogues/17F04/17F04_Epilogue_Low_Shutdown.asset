    voiceClip: {fileID: 8300000, guid: 27275c0420f6e70478830ce9cfa7e867, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_008
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: How'd you know I was up?
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: aa7c8e31a29ca644f80cf20dfd90067c, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_007
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Lucky guess.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 783606dd79f9ef443bcbc653800b5e6f, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
