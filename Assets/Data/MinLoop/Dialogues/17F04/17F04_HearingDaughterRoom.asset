    voiceClip: {fileID: 8300000, guid: 9440800e1d9094543bc186b47e8ad123, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_HearingDaughterRoom_MiasHomeUnit_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: "Same spot. That's okay\u2014don't rush it. You're doing way better than
      yesterday."
    holdSeconds: 5.678302
    voiceClip: {fileID: 8300000, guid: 6c7cfa8e8f18be04aa8cb8e5902fe715, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_HearingDaughterRoom_Lily_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Lily
    text: Will you be there tomorrow? Like, right there next to me?
    holdSeconds: 5.3009434
    voiceClip: {fileID: 8300000, guid: d1849e0a132ef5846b189fff1c497c58, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_HearingDaughterRoom_MiasHomeUnit_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: I'll be in the audience. I'll be right there.
    holdSeconds: 4.5462265
    voiceClip: {fileID: 8300000, guid: 55b035e7f7ebbd743a49ffdb008ff86c, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_HearingDaughterRoom_Lily_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Lily
    text: And Mom?
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 93ce8a995531bd64584844072dbc1d0d, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_HearingDaughterRoom_MiasHomeUnit_005
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: She'll be there too.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: a5ef1ac6f98cadc4c95a489e02d9f633, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
