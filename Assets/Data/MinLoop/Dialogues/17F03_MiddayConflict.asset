    text: 'Decision: initiate family conflict de-escalation.'
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Synth Voice
    text: Face the daughter and relay the mother's intent.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
