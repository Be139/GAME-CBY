    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Mia_006
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: I'm right here.
