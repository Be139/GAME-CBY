  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_SecondPhoto
  m_EditorClassIdentifier: 
  sequenceId: 17F04_SecondPhoto
  notes: Optional second photo; used only when a second texture is assigned.
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: Field Unit
    text: This one is from last week. Lily is sitting under her desk lamp, holding
      a certificate. The home unit took the picture. You're not in it.
    holdSeconds: 10.96132
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Field Unit
    text: Her smile-stability score is higher here than in the Christmas photo. Since
      the home unit came online, her overall emotional stability has increased by
      twenty-three point four percent.
    holdSeconds: 11.716038
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Field Unit
    text: That is one measurable benefit to this household.
    holdSeconds: 4.1688676
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
