%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Epilogue_Low_Shutdown
  m_EditorClassIdentifier: 
  sequenceId: 17F04_Epilogue_Low_Shutdown
  notes: 'Centered black-screen ending: low trust plus shutdown.'
  lines:
  - startDelay: 0.3
    speaker: Field Companion
    text: Inspector. The household unit has been shut down.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: From the first home to the last, you did not change.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Field Companion
    text: I never fully understood your choices. But tonight, I want to record this
      sentence.
    holdSeconds: 4.6
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.4
    speaker: Field Companion
    text: I remember tonight. This shift is over. Thank you for your work.
    holdSeconds: 4.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Lily
    text: Mom, are you making breakfast again today?
    holdSeconds: 3
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Mia
    text: Yes. I will for the next few days.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Lily
    text: Will that get in the way of work?
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Mia
    text: No. Mom has this time.
    holdSeconds: 2.5
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Mia
    text: I understand. I will sign the paperwork. I want work that lets me come
      home earlier.
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: Lily
    text: Mom.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Mia
    text: I am here.
    holdSeconds: 2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.5
    speaker: Lily
    text: Thank you for coming yourself.
    holdSeconds: 3
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.8
    speaker: System
    text: Lily, age 9. Open Day, the next morning. Mom came and sat in the first
      row. She left the night job. She said it was worth it. She stayed.
    holdSeconds: 6.5
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  postSequenceDelay: 0
