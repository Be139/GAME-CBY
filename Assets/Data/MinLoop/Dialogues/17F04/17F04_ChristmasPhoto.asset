  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_ChristmasPhoto
  m_EditorClassIdentifier: 
  sequenceId: 17F04_ChristmasPhoto
  notes: '17F04 photo-frame narration. Source: HEARTH_Full_Game_Script_Expanded_Native_English_Lobby_Mia_Commentary.md,
    stable marker 17F04_ChristmasPhoto. Text is synchronized by Tools/Hearth/Dialogue/Sync
    All Dialogue From Final Script.'
  lines:
  - startDelay: 0.15
    speaker: Field Unit
    text: This one is from Christmas 2024. You took half a day off and came home
      for dinner. The kitchen timer took the picture. Lily was seven. That is a piece
      of turkey on her fork.
    holdSeconds: 12
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Field Unit
    text: You are both looking at the camera. You are both smiling.
    holdSeconds: 5.3009434
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Field Unit
    text: This one is from last week. Lily is under her desk lamp, holding a certificate.
      The household unit took the photo. It records one or two growth images each
      month and syncs them to you.
    holdSeconds: 12
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Field Unit
    text: Her smile-stability score is higher in this photo than in the Christmas
      picture. Since the unit came online, Lily's overall emotional stability has
      increased by twenty-three point four percent.
    holdSeconds: 12
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Field Unit
    text: That is one measurable benefit to this household.
    holdSeconds: 4.1688676
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Field Unit
    text: "Inspector, Lily's room, when you're ready\u2014"
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
