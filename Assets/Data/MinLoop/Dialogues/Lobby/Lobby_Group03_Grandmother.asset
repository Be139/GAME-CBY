  sequenceId: Lobby_Group03_Grandmother
  notes: 'Optional Mrs. Ellis and care-unit conversation. Source: HEARTH_Full_Game_Script_Expanded_Native_English_Lobby_Mia_Commentary.md,
    stable marker Lobby_Group03_Grandmother. Text is synchronized by Tools/Hearth/Dialogue/Sync
    All Dialogue From Final Script.'
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: Mrs. Ellis
    text: How old is she now?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Care Unit
    text: She's nine, Mrs. Ellis. She sent you a drawing yesterday.
    holdSeconds: 4.923585
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: What did she draw?
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Care Unit
    text: The two of you, holding hands.
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: Oh, that's sweet. Why didn't she show me?
    holdSeconds: 4.1688676
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Care Unit
    text: She did, Mrs. Ellis. This is the third time you've asked. Would you like
      to see it again?
    holdSeconds: 7.9424524
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: Yes, put it up.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
