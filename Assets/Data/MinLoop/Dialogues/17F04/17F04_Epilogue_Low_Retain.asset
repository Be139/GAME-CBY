  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Epilogue_Low_Retain
  m_EditorClassIdentifier: 
  sequenceId: 17F04_Epilogue_Low_Retain
  notes: '17F04 path B black-screen epilogue (negative trust compatibility variant).
    Source: HEARTH_Full_Game_Script_Expanded_Native_English_Lobby_Mia_Commentary.md,
    Scene 4.8. Text is synchronized by Tools/Hearth/Dialogue/Sync All Dialogue From
    Final Script.'
  lines:
  - startDelay: 0.15
    speaker: Mia's Home Unit
    text: Lily, your mom is leaving a little later today. Eat something first. I'll
      sit with you.
    holdSeconds: 7.1877356
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: She asked me to tell you everything is packed. It is by the door.
    holdSeconds: 6.4330187
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: Good luck at the open house.
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: Right, I'll be in by nine-thirty. Yeah, the open house. I'll have the unit
      record it. Fine. That works.
    holdSeconds: 8.319811
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, your mom couldn't make it today. I watched for her. You did really
      well.
    holdSeconds: 6.810377
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: She asked me to tell you she is proud of you.
    holdSeconds: 5.3009434
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Did she actually say that?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: She did.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: What you just said... is that what she said, or is that what you made it
      sound like?
    holdSeconds: 7.9424524
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: It is what she meant.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: Oh.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: I'm moving into the dorms.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: What? That's... that's sudden.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: It isn't. I applied six months ago.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: Why didn't you tell me?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: I told the unit. It told you. Three times.
    holdSeconds: 4.5462265
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: I thought those were routine updates.
    holdSeconds: 3.414151
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Lily
    text: I know.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: Mia, Lily has left. She asked me to tell you she will be back for the holidays.
    holdSeconds: 7.565094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia
    text: Did she actually say that?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - startDelay: 0.18
    speaker: Mia's Home Unit
    text: Yes.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
