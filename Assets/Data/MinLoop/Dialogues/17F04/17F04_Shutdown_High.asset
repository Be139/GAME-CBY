MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Shutdown_High
  m_EditorClassIdentifier:
  sequenceId: 17F04_Shutdown_High
  notes: High-trust graceful shutdown after one confirmation.
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: Mia
    text: I'm shutting you down.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, your mom is here now. I can go.
    holdSeconds: 4.5462265
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, before I go, I need you to hear something.
    holdSeconds: 4.923585
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: When it thunders, you get scared. You tell me, but you don't tell Mom.
      Starting tonight, tell her. She'll come.
    holdSeconds: 8.697169
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Mia.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: The rest is up to you now. She needs you.
    holdSeconds: 4.923585
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: Okay.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Lily
    text: Mom... I already miss it.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: I know, baby.
    holdSeconds: 2.2820754
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
