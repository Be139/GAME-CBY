    voiceTailSeconds: 0
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_001
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.15
    speaker: Mia's Home Unit
    text: Lily, your mom's running a little late today. Come eat something first.
      I'll sit with you.
    holdSeconds: 7.1877356
    voiceClip: {fileID: 8300000, guid: 5554347e50f1e6e4ba0237bf2a134d24, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_001
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 3ab3d453f6ba7ed4fb5a75d2312a2495, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_002
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: She asked me to tell you everything's packed. It's by the door.
    holdSeconds: 5.678302
    voiceClip: {fileID: 8300000, guid: 3604dc9751819fd4b9644e906d523579, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_002
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: e3129c8a4d039d34793336d8ed957ee8, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_003
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Good luck at the open house.
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: fc79098437100154dbc85ef2b86450d2, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_003
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 90bf29835360b0945980ae86bae3e80f, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Mia_001
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Right, I'll be in by nine-thirty. Yeah, the open house. I'll have the unit
      record it. Yeah. That works.
    holdSeconds: 8.319811
    voiceClip: {fileID: 8300000, guid: 4e59157adabcff34eaa8dfa1a5d45107, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_Retain_TimeCard_OpenHouse
    presentationKind: 1
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: 
    text: "THAT AFTERNOON \u2014 SCHOOL OPEN HOUSE"
    holdSeconds: 1.5
    voiceClip: {fileID: 0}
    durationMode: 1
    voiceTailSeconds: 0
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_004
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Lily, your mom couldn't make it today. But I was there. You did really
      well.
    holdSeconds: 6.810377
    voiceClip: {fileID: 8300000, guid: f17ef16777f68f842b06e0fde5deda70, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_004
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Mm.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: bdd5480ea49e8a0479a9586eaa17b792, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_005
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: She asked me to tell you she's proud of you.
    holdSeconds: 4.923585
    voiceClip: {fileID: 8300000, guid: f2563a8c46392e44fb21cc309cee73fa, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_005
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Did she actually say that?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 82186367f2284d64c9a1b965760bf0cd, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_006
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: She did.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 8f0bad2f7b3074842aa6b93eaed1d052, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_006
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: What you just said... is that what she actually said, or just what you
      made it sound like?
    holdSeconds: 7.9424524
    voiceClip: {fileID: 8300000, guid: cdd5248e9305fe6469051575ac39c5d3, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_007
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: It's what she meant.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: bfc243f943a13ff48b059eda9d2e87ec, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_007
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: Oh.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 263065102707dd445b90f056f218d1a0, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_Retain_TimeCard_ThreeYearsLater
    presentationKind: 1
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: 
    text: "THREE YEARS LATER \u2014 FRONT HALL"
    holdSeconds: 1.5
    voiceClip: {fileID: 0}
    durationMode: 1
    voiceTailSeconds: 0
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_008
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: I'm moving into the dorms.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: a8ea91c1d9cff9f4083a4cfb13fd3e67, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Mia_002
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: "What? That's... when did you\u2014that's so sudden."
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: 07928996bab0b194b91bca4fa25dbead, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_009
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: It's not. I applied six months ago.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: bbfe7b8cdb80b4341b63feeb3efb1eba, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Mia_003
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Why didn't you tell me?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 836d2805beea85d44b5746144294dc7c, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_010
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: I told the unit. It told you. Three times.
    holdSeconds: 4.5462265
    voiceClip: {fileID: 8300000, guid: 557c0fbd0b004834297115098b1e8073, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Mia_004
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: I thought those were just... routine updates.
    holdSeconds: 3.7915094
    voiceClip: {fileID: 8300000, guid: 4168766e96db20d4bb49a75a7483293b, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Lily_011
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Lily
    text: I know.
    holdSeconds: 2.2
    voiceClip: {fileID: 8300000, guid: 89596467665fd4c4898d2054af184b21, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_008
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Mia, Lily left. She asked me to tell you she'll be back for the holidays.
    holdSeconds: 6.810377
    voiceClip: {fileID: 8300000, guid: 0554e65d77a135c428976b647b2222b1, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_Mia_005
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia
    text: Did she actually say that?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: d55d21e9be3017a43a003b34ff2b5997, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: 17F04_Epilogue_High_Retain_17F04_Epilogue_Low_Retain_MiasHomeUnit_009
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Yes.
    holdSeconds: 2.2
