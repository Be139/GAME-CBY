  lines:
  - lineId: Lobby_Group03_Grandmother_CareUnit_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.15
    speaker: Care Unit
    text: Mrs. Ellis, please look at the screen on my chest. Your granddaughter sent
      you a drawing yesterday.
    holdSeconds: 7.565094
    voiceClip: {fileID: 8300000, guid: 88c1f2e28e61c3546ac1c9064fb270b7, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_MrsEllis_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: How old is she now?
    holdSeconds: 3.0367923
    voiceClip: {fileID: 8300000, guid: 886e358c840bcab47ae7dbd1783dc239, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_CareUnit_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Care Unit
    text: She's nine, Mrs. Ellis.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: 14b136861fb83f64882677519aceef29, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_MrsEllis_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: What did she draw?
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: f02ebf8dd8713e54586c971e67bbdd6d, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_CareUnit_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Care Unit
    text: The two of you, holding hands.
    holdSeconds: 3.414151
    voiceClip: {fileID: 8300000, guid: fdc21b3f593b0b74291a3a8ff5564323, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_MrsEllis_003
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: Oh, that's sweet. Why didn't she show me?
    holdSeconds: 4.1688676
    voiceClip: {fileID: 8300000, guid: 988039223b9a887478419ff169b929da, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_CareUnit_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Care Unit
    text: She did, Mrs. Ellis. This is the third time you've asked. Would you like
      to see it again?
    holdSeconds: 7.9424524
    voiceClip: {fileID: 8300000, guid: bb903f11feea2c440885f06f295a4f73, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  - lineId: Lobby_Group03_Grandmother_MrsEllis_004
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Mrs. Ellis
    text: Yes, put it up.
    holdSeconds: 2.6594338
    voiceClip: {fileID: 8300000, guid: b4a99ad1cff55fd47935ed514f6bc3d4, type: 3}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
