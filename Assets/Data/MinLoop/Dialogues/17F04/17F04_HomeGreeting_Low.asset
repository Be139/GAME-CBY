  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_HomeGreeting_Low
  m_EditorClassIdentifier: 
  sequenceId: 17F04_HomeGreeting_Low
  notes: Low-trust greeting after entering Mia's home.
  lines:
  - startDelay: 0.2
    speaker: Field Companion
    text: Inspector, you are home.
    holdSeconds: 2.4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: Tonight, you chose low intervention in all three households. That is unusual
      in your record.
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: Handling cases this way takes effort. Most inspectors do not do it, because
      following the system is easier.
    holdSeconds: 5.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.3
    speaker: Field Companion
    text: Are you still willing to spend that effort here?
    holdSeconds: 3.5
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  postSequenceDelay: 0
