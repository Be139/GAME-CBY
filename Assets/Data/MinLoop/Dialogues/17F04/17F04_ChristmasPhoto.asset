  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_ChristmasPhoto
  m_EditorClassIdentifier: 
  sequenceId: 17F04_ChristmasPhoto
  notes: Mandatory Christmas photo inspection at TV (4).
  lines:
  - startDelay: 0.2
    speaker: Field Companion
    text: Inspector, this is a family photo from last Christmas.
    holdSeconds: 3.6
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: That evening, you took half a day off to come home. The kitchen timer took
      this photo.
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: Your daughter was seven at the time.
    holdSeconds: 3
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: 'Family Emotional Stability Score that night: 9.4 out of 10. The highest
      that year.'
    holdSeconds: 4.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  postSequenceDelay: 0
