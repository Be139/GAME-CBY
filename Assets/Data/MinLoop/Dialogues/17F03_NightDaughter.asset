  m_Name: 17F03_NightDaughter
  m_EditorClassIdentifier:
  sequenceId: 17F03_NightDaughter
  notes: '17F03 night conversation with Ava. Source: HEARTH_Full_Game_Script_No_Audio_Tags_Native_English.md,
    stable marker 17F03_NightDaughter. Text is synchronized by Tools/Hearth/Dialogue/Sync
    All Dialogue From Final Script.'
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: 17F-03 Synth Voice
    text: 'Decision: open dialogue mode. Reason: Ava initiated contact.'
    holdSeconds: 4.1688676
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Ava
    text: Can you please stop talking for us?
    holdSeconds: 3.7915094
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: 17F-03 Synth Voice
    text: 'Decision: standard response. Reason: subject expression can be guided.'
    holdSeconds: 4.5462265
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: 17F-03 Home Unit
    text: If you would rather speak to your parents directly, I can step aside.
    holdSeconds: 6.0556602
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Ava
    text: That's not what I mean.
    holdSeconds: 3.0367923
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Ava
    text: Mom used to get on my case. Dad used to knock on my door himself. They
      don't anymore. Mom talks to you more than she talks to me. Dad came home today
      and asked you how I was. He didn't ask me.
    holdSeconds: 12
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Ava
    text: You know them better every day. They know me less.
    holdSeconds: 4.923585
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
