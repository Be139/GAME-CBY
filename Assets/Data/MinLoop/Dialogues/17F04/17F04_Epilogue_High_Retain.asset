MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_Epilogue_High_Retain
  m_EditorClassIdentifier: 
  sequenceId: 17F04_Epilogue_High_Retain
  notes: 'Centered black-screen ending: high trust plus retaining the unit.'
  lines:
  - startDelay: 0.2
    speaker: Field Companion
    text: 'Household emotional stability has returned to the safe zone. Overall rating:
      excellent.'
    holdSeconds: 4.6
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Field Companion
    text: A perfect night. Thank you for your work.
    holdSeconds: 3.4
    voiceClip: {fileID: 0}
  - startDelay: 0.6
    speaker: Lily
    text: Yesterday's problem made sense to me later.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Home Companion
    text: I knew you could understand it. You were already very close.
    holdSeconds: 3.8
    voiceClip: {fileID: 0}
  - startDelay: 0.6
    speaker: Mia
    text: What time is my meeting today?
    holdSeconds: 3
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Home Companion
    text: Ten. I left tea on the table. You slept late, so do not rush.
    holdSeconds: 4
    voiceClip: {fileID: 0}
  - startDelay: 0.7
    speaker: Mia
    text: Morning.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Lily
    text: Morning.
    holdSeconds: 1.8
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Mia
    text: Is anything happening today?
    holdSeconds: 2.6
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Lily
    text: No. Everything is fine.
    holdSeconds: 2.4
    voiceClip: {fileID: 0}
  - startDelay: 0.8
    speaker: Home Companion
    text: Mia, Lily won the city award. She was very happy and spoke to me for a
      long time.
    holdSeconds: 5
    voiceClip: {fileID: 0}
  - startDelay: 0.3
    speaker: Mia
    text: Why did she not tell me?
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.2
    speaker: Home Companion
    text: She asked me to tell you first.
    holdSeconds: 2.8
    voiceClip: {fileID: 0}
  - startDelay: 0.8
    speaker: System
    text: 'Family Emotional Stability: SAFE. Usage: 6 years. High-satisfaction sample.
      Everyone in this home is accompanied.'
    holdSeconds: 6
    voiceClip: {fileID: 0}
  postSequenceDelay: 0
