  - lineId: 17F04_HearingDaughterRoom_Lily_001
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Lily
    text: Hi, everyone. I'm Lily, and today I want to tell you about my...
    holdSeconds: 6.0556602
    voiceClip: {fileID: 8300000, guid: fec25e949d39f9b43995846eb9072f66, type: 3}
