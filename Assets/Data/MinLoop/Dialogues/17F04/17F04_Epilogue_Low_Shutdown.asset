  - lineId: 17F04_Epilogue_High_Shutdown_17F04_Epilogue_Low_Shutdown_Lily_001
    presentationKind: 2
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 2
    startDelay: 0.15
    speaker: Lily
    text: Mom, don't cook them so long this time.
