  m_Script: {fileID: 11500000, guid: bf2d7532251303545ab78ab68b00d5cf, type: 3}
  m_Name: 17F04_HomeGreeting_High
  m_EditorClassIdentifier:
  sequenceId: 17F04_HomeGreeting_High
  notes: High-trust greeting after entering Mia's home.
  lines:
  - presentationKind: 0
    startDelay: 0.15
    speaker: Lily
    text: Mom? Are you coming tomorrow? Ms. Parker said it'd be better if a real
      person came. Not just a system check-in.
    holdSeconds: 9.074528
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia's Home Unit
    text: Mom will receive your progress report and make sure you have everything
      you need. Let's finish tonight's practice first, okay?
    holdSeconds: 8.697169
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Field Unit
    text: Please acknowledge that you've reviewed the pending response. Then return
      home and address it directly.
    holdSeconds: 6.810377
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  - presentationKind: 0
    startDelay: 0.18
    speaker: Mia
    text: I know.
    holdSeconds: 2.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0.12
  postSequenceDelay: 0.18
