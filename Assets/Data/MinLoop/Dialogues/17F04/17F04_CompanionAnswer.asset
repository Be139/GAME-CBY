  m_Name: 17F04_CompanionAnswer
  m_EditorClassIdentifier: 
  sequenceId: 17F04_CompanionAnswer
  notes: 'B route: the Companion Unit answers Lily.'
  lines:
  - startDelay: 0.3
    speaker: Home Companion
    text: Mom will see your performance summary, and she will prepare what you need.
    holdSeconds: 4.4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Home Companion
    text: For tonight, finish this practice with me. All right?
    holdSeconds: 3.5
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.7
    speaker: Lily
    text: ...Okay. Then we will finish it.
    holdSeconds: 3.2
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Home Companion
    text: Good. We will start from your name and take it slowly.
    holdSeconds: 3.8
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.6
    speaker: Field Companion
    text: Household emotional stability has returned to the safe zone.
    holdSeconds: 3.5
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  - startDelay: 0.2
    speaker: Field Companion
    text: 'This shift''s overall rating: excellent. The case can be archived.'
    holdSeconds: 4
    voiceClip: {fileID: 0}
    durationMode: 0
    voiceTailSeconds: 0
  postSequenceDelay: 0
