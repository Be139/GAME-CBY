  - lineId: 17F04_HearingDaughterRoom_Lily_002
    presentationKind: 0
    dialogueMode: 0
    speakerSide: 0
    advancePolicy: 0
    startDelay: 0.18
    speaker: Lily
    text: My favorite book.
